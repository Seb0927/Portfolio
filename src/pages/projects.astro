---
import { siReact, siNextdotjs, siTailwindcss, siGo } from "simple-icons";
import azureIcon from "@/assets/icons/azure.svg?raw";
import geminiIcon from "@/assets/icons/gemini.svg?raw";
import Layout from "../layouts/Layout.astro";
import PageTitle from "@/components/PageTitle.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import { getCollection } from "astro:content";

const iconMap: Record<string, string> = {
  react: siReact.svg,
  nextdotjs: siNextdotjs.svg,
  tailwindcss: siTailwindcss.svg,
  go: siGo.svg,
  azure: azureIcon,
  gemini: geminiIcon,
};

const projects = await getCollection("projects");

// Auto-discover demo videos by convention: src/assets/images/projects/<id>/output.{mp4,webm}
// No manual imports — adding a new project just requires dropping the files in a folder
// matching the markdown filename. Vite hashes + copies them at build time.
const videoGlob = import.meta.glob(
  "/src/assets/images/projects/*/output.{mp4,webm}",
  { eager: true, query: "?url", import: "default" },
) as Record<string, string>;

const demoVideoMap: Record<string, { mp4: string; webm: string }> = {};
for (const [path, url] of Object.entries(videoGlob)) {
  const match = path.match(/\/projects\/([^/]+)\/output\.(mp4|webm)$/);
  if (match) {
    const [, projectId, ext] = match as [string, string, "mp4" | "webm"];
    demoVideoMap[projectId] ??= { mp4: "", webm: "" };
    demoVideoMap[projectId][ext] = url;
  }
}
---

<Layout title="Projects" theme="purple" blobType="circle-pentagon">
  <PageTitle text="My work" />

  <div class="flex w-full flex-col gap-12 md:gap-20">
    {
      projects.map((project, i) => (
        <ProjectCard
          title={project.data.title}
          description={project.data.description}
          icons={project.data.icons.map((name) => ({
            svg: iconMap[name],
          }))}
          image={project.data.image}
          imageAlt={project.data.imageAlt}
          imagePosition={i % 2 === 0 ? "right" : "left"}
          demoVideo={demoVideoMap[project.id]}
        />
      ))
    }
  </div>
</Layout>
