---
import { getRelativeLocaleUrl } from "astro:i18n";
import { useTranslations, toLang } from "@/i18n/utils";

const lang = toLang(Astro.currentLocale);
const t = useTranslations(lang);

// Localized labels + locale-prefixed paths, so the active-path matching
// and sliding-window logic below work unchanged in every locale.
// getRelativeLocaleUrl emits trailing slashes ("/es/projects/"); strip them
// to match the normalized currentPath below.
const localizePath = (path: string) =>
  getRelativeLocaleUrl(lang, path).replace(/\/$/, "") || "/";

const navLinks = [
  { label: t("nav.home"), path: localizePath("/") },
  { label: t("nav.projects"), path: localizePath("/projects") },
  { label: t("nav.blog"), path: localizePath("/blog") },
  {
    label: t("nav.experience"),
    path: localizePath("/experience"),
  },
  { label: t("nav.contact"), path: localizePath("/contact") },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";

// A link is active when it equals the current path or is an ancestor segment
// of it (e.g. `/blog` on `/blog/my-post`). The longest match wins so the
// locale root (`/es`) does not shadow its own children.
const activeIndex = navLinks.reduce<number>((best, link, index) => {
  const matches =
    currentPath === link.path || currentPath.startsWith(`${link.path}/`);
  if (!matches) return best;
  return best === -1 || link.path.length > navLinks[best].path.length
    ? index
    : best;
}, -1);

const activePath = activeIndex >= 0 ? navLinks[activeIndex].path : undefined;

let mobileLinks;
if (activeIndex <= 0) {
  mobileLinks = navLinks.slice(0, 3);
} else if (activeIndex >= navLinks.length - 1) {
  mobileLinks = navLinks.slice(-3);
} else {
  mobileLinks = navLinks.slice(activeIndex - 1, activeIndex + 2);
}
---

<!-- Desktop nav: all 5 links -->
<div class="z-10 mt-4 hidden w-full max-w-xl md:block">
  <nav aria-label={t("nav.ariaLabel")}>
    <ul class="flex flex-row justify-center">
      {
        navLinks.map((link) => (
          <li
            class="flex-1 p-2 text-center"
            transition:name={`nav-desktop-${link.path}`}
          >
            <a
              href={link.path}
              class="block w-full"
              aria-current={link.path === activePath ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="flex h-1.5 flex-row">
    {
      navLinks.map((link) => {
        const isActive = link.path === activePath;
        return (
          <div class="flex-1 bg-(--theme-default) transition-colors duration-700">
            {isActive && (
              <div
                transition:name="nav-indicator-desktop"
                class="h-full w-full bg-(--theme-darkest)"
              />
            )}
          </div>
        );
      })
    }
  </div>
</div>

<!-- Mobile nav: 3 visible links with sliding window -->
<div class="z-10 mt-4 block w-full max-w-xs md:hidden">
  <nav aria-label={t("nav.ariaLabel")}>
    <ul class="flex flex-row justify-center">
      {
        mobileLinks.map((link) => (
          <li
            class="flex-1 p-2 text-center font-medium"
            transition:name={`nav-mobile-${link.path}`}
          >
            <a
              href={link.path}
              class="block w-full"
              aria-current={link.path === activePath ? "page" : undefined}
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>

  <div class="flex h-1.5 flex-row">
    {
      mobileLinks.map((link) => {
        const isActive = link.path === activePath;
        return (
          <div class="flex-1 bg-(--theme-default) transition-colors duration-700">
            {isActive && (
              <div
                transition:name="nav-indicator-mobile"
                class="h-full w-full bg-(--theme-darkest)"
              />
            )}
          </div>
        );
      })
    }
  </div>
</div>
