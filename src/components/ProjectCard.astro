---
import { Image } from "astro:assets";
import TechIcon from "./TechIcon.astro";

interface Props {
  title: string;
  description: string;
  icons: { svg: string; class?: string }[];
  image: ImageMetadata;
  imageAlt: string;
  imagePosition: "left" | "right";
}

const { title, description, icons, image, imageAlt, imagePosition } =
  Astro.props;
---

<!--
  min-w-0 on both flex children is required for Firefox: without it, the
  default min-width: auto lets the aspect-video child's intrinsic width
  feed back into the flex algorithm, breaking the layout. Chrome tolerates
  this
-->
<section class="flex w-full flex-col gap-8 md:gap-12 lg:flex-row lg:gap-16">
  {
    imagePosition === "left" && (
      <div class="hidden min-w-0 grow basis-0 items-center justify-center transition-[flex-grow] duration-300 ease-out lg:flex lg:hover:grow-[1.8] xl:hover:grow-[1.5]">
        <div class="flex aspect-video w-full items-center justify-center rounded-4xl bg-white">
          <Image
            class="h-5/12 min-h-16 object-scale-down"
            src={image}
            alt={imageAlt}
            layout="constrained"
          />
        </div>
      </div>
    )
  }

  <div class="flex min-w-0 flex-2 flex-col justify-center gap-4 lg:gap-4">
    <h2 class="text-xl font-semibold lg:text-3xl">{title}</h2>
    <p>{description}</p>

    <div
      class="my-2 flex min-h-full w-full items-center justify-center lg:hidden"
    >
      <div
        class="flex size-full h-48 max-w-xs items-center justify-center rounded-4xl bg-white lg:hidden"
      >
        <Image
          class="max-h-20 max-w-20"
          src={image}
          alt={imageAlt}
          layout="constrained"
        />
      </div>
    </div>

    <div class="flex w-full flex-row gap-8">
      {icons.map((icon) => <TechIcon svg={icon.svg} class={icon.class} />)}
    </div>
  </div>

  {
    imagePosition === "right" && (
      <div class="hidden min-w-0 grow basis-0 items-center justify-center transition-[flex-grow] duration-300 ease-out lg:flex lg:hover:grow-[1.8] xl:hover:grow-[1.5]">
        <div class="flex aspect-video w-full items-center justify-center rounded-4xl bg-white">
          <Image
            class="h-5/12 min-h-16 object-scale-down"
            src={image}
            alt={imageAlt}
            layout="constrained"
            loading="eager"
            fetchpriority="high"
          />
        </div>
      </div>
    )
  }
</section>
